{
  "name": "doc-assistant",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "test:e2e": "playwright test",
    "dev:api": "npm run start -w doc-api",
    "dev:web": "npm run dev -w doc-web"
  }
}
