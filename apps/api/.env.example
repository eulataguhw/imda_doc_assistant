# Doc Assistant API — environment configuration
# Loaded by `node --env-file=.env` (Node 24 built-in loader; no dotenv dependency).
# Canonical ENV contract: docs/plan.md — env.ts, this file, and that table must stay in sync (API-M5-8).

PORT=3001
DATABASE_PATH=../../data/doc-assistant.db

# --- LLM / embeddings (OpenAI-compatible; provider-agnostic) -------------------
# Ollama (local):
LLM_BASE_URL=http://localhost:11434/v1
# llama.cpp server (llama-server --port 8080):
# LLM_BASE_URL=http://host:8080/v1
# Cloud (OpenAI-compatible, e.g. OpenAI):
# LLM_BASE_URL=https://api.openai.com/v1

# Chat model id — Ollama: model tag; llama.cpp: served GGUF name; cloud: e.g. gpt-4o-mini
LLM_MODEL=qwen2.5:7b-instruct-q4_K_M

# Embeddings root; defaults to LLM_BASE_URL when unset (embeddings may run on a different box/provider than chat)
# EMBED_BASE_URL=http://embed-box:8080/v1

# Embedding model id — Ollama: nomic-embed-text; llama.cpp: embedding GGUF name; cloud: e.g. text-embedding-3-small
EMBED_MODEL=nomic-embed-text

# Optional API key; when set, Authorization: Bearer <key> is sent on LLM calls (Ollama/llama.cpp ignore it)
# LLM_API_KEY=sk-...

# M6 sampling params for chat + summary generation (API-M6-2). Defaults shown.
LLM_TEMPERATURE=0.2
# top_p is omitted from requests entirely when unset (leave commented out to omit)
# LLM_TOP_P=0.9
LLM_MAX_TOKENS=1024

QDRANT_BASE_URL=http://localhost:6333

# Upload size cap in MB
MAX_UPLOAD_MB=10
