# Doc Assistant web — environment configuration
#
# Local development: NO client env vars are required.
# The Vite dev server proxies /api → http://localhost:3001 (see vite.config.ts),
# so the app can call the API with same-origin relative URLs and no import.meta.env
# values are read at runtime today.

# Optional override: base URL for API calls, if you ever deploy web and api on
# different origins or ports. Only takes effect once the code reads it — currently
# nothing in src/ consumes VITE_API_BASE (confirmed by grep), so this is reserved.
# VITE_API_BASE=http://localhost:3001
